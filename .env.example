# AWS 계정 설정 (cdk bootstrap / deploy 시 사용)
CDK_DEFAULT_ACCOUNT=123456789012
CDK_DEFAULT_REGION=ap-northeast-2

# 애플리케이션 환경
NODE_ENV=production

# 프론트엔드 빌드 변수 (frontend/ — Vite, VITE_ 접두사만 번들에 노출)
# API/CloudFront 오리진
VITE_API_URL=https://dev.chum7.com
VITE_CLOUDFRONT_URL=https://dxxxx.cloudfront.net
# 챌린지 채팅 WebSocket 엔드포인트 — 배포 후 CDK 출력 ChatWebSocketUrl 값(wss://...)
VITE_WS_URL=wss://xxxx.execute-api.ap-northeast-2.amazonaws.com/dev
